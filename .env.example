# =====================================================================
# Variáveis de ambiente. Copie para .env (local) ou cadastre na Vercel.
# Sem .env: modo desenvolvimento, SQLite e anexos em media/.
# Produção (Vercel + Supabase): ver docs/06-deploy.md.
# =====================================================================

# ---------- Django ----------
# Produção: chave aleatória de 40+ caracteres. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
# Produção: false (liga HTTPS, cookies seguros e HSTS; recusa chave fraca).
DJANGO_DEBUG=true
# Produção: o domínio da Vercel, ex.: portal-sac.vercel.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Produção: https://portal-sac.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---------- Banco ----------
# Vazio = SQLite (db.sqlite3). Supabase, sempre com o usuário django_app
# (criado por deploy/supabase.sql), cujas tabelas ficam no schema `django`:
#   Vercel (pooler, modo transação, porta 6543):
#     postgresql://django_app.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
#   migrate/createsuperuser na sua máquina (conexão direta, porta 5432):
#     postgresql://django_app:<senha>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=
# Schema esperado (o check ocorrencias.E001 barra o migrate fora dele).
DB_SCHEMA=django
# SSL do Postgres (padrão require). Só para um Postgres local sem SSL: disable.
# DB_SSLMODE=require

# ---------- Anexos ----------
# local (media/) ou supabase (bucket privado, URLs assinadas de 60 s).
STORAGE_BACKEND=local
# Supabase > Project Settings > Storage > S3 Connection / S3 Access Keys
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_BUCKET=anexos-django
SUPABASE_S3_KEY=
SUPABASE_S3_SECRET=
SUPABASE_S3_REGION=
# Soma máxima dos anexos de um envio, em MB. Na Vercel use 4 (limite de 4,5 MB
# por requisição; as fotos são reduzidas no navegador antes do envio).
UPLOAD_MAX_TOTAL_MB=50

# ---------- Tarefas agendadas ----------
# Segredo do Vercel Cron (/cron/arquivar, diário). Vazio desliga a rota.
CRON_SECRET=

# ---------- E-mail (SMTP, ex.: Gmail) ----------
# Sem as 4 variáveis, os e-mails saem no console (útil para pegar links de
# convite em desenvolvimento).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# URL base usada nos links dos e-mails (produção: https://portal-sac.vercel.app)
SITE_URL=http://localhost:8000
