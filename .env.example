# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Em produção atrás de HTTPS, ex.: https://ocorrencias.suaempresa.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=

# Banco: vazio = SQLite (db.sqlite3). Para PostgreSQL:
# DB_ENGINE=postgresql
# DB_NAME=ocorrencias
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# SMTP (ex: Gmail) - envio de e-mails transacionais. Sem isso, os e-mails
# saem no console do runserver (útil para pegar links de convite em dev).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# URL base usada nos links dos e-mails
SITE_URL=http://localhost:8000
